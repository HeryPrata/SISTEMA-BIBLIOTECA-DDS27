<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <!-- IMPORTAÇÃO DO CSS DO BOOTSTRAP -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe"
      crossorigin="anonymous"
    />
  </head>
  <body class=" d-flex flex-column min-vh-100 ">
    
    <header class="bg-warning text-center">
      <!-- UMA BARRA DE NAVEGAÇÃO -->
      <nav class="navbar sm:navbar-expand bg-1" data-bs-theme="dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/usuarios">C&G SOLUTIONS</a>
          <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
          </button>
          <dialog class="drawer drawer-end" tabindex="-1" id="navbarNav" aria-labelledby="navbarNavLabel">
            <div class="drawer-header">
              <h5 class="drawer-title" id="navbarNavLabel">Menu</h5>
              <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
            </div>
            <div class="drawer-body">
              <ul class="navbar-nav">
                <li class="nav-item">
                  <a class="nav-link active" aria-current="page" href="/livros">Livros</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/usuarios">Usuários</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/emprestimos">Empréstimos</a>
                </li>
              </ul>
            </div>
          </dialog>
        </div>
      </nav>
