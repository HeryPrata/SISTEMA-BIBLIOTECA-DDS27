<%- include('../partials/header') %>
<main class="bg-danger container my-2 flex-grow-1">
    <h1 class="fg-accent fs-6x1">    
        ESTOU NA PÁGINA DE EDIÇÃO DE USUARIO
    </h1>


    <div class="d-flex flex-column">
        <!-- ACTION - FALA A ROTA QUE O BOTAO VAI ENVIAR AS INFORMACÕES -->
        <form action="/usuarios/editar/<%= usuarioEditado.id_usuario %>" method="post">
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" name="email" id="email" required value="<%= usuarioEditado.nome %>">
            </div>

            <div>
                <label for="nome">Nome:</label>
                <input type="text" name="nome" id="nome" required value="<%= usuarioEditado.email %>">
            </div>

            <div>
                <label for="senha">Senha:</label>
                <input type="password" name="senha" id="senha" required value="<%= usuarioEditado.senha %>">
            </div>
            
            <div>
                <label for="perfil">Perfil:</label>
                <select name="perfil" id="perfil">
                    <option value="adm" <%= usuarioEditado.perfil === "adm" ? 'selected' : " " %> >Administrador</option>
                    <option value="biblioteca" <%= usuarioEditado.perfil === "biblioteca" ? 'selected' : " " %> >Bibliotecaria</option>
                </select>
            </div>
            
            <button type="submit" class="btn-subtle theme-sucess mt-3">Entrar</button>
    </div>
</main>

<!-- IMPORTACAO DO FOOTER -->
<%- include('../partials/footer') %>